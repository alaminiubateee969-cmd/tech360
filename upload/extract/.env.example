APP_NAME="TECH360 LLC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bdtech360.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_EXCEPTIONS=true

# === Database (Production MySQL on bdtech360.com server) ===
# Host is 127.0.0.1 because MySQL runs on the same server as the app.
# Replace DB_PASSWORD with the rotated value (DO NOT use the exposed one).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_bdtech
DB_USERNAME=user_bdtech
DB_PASSWORD=
# Optional SSL — leave empty unless your MySQL server requires SSL
DB_SSLMODE=preferred
DB_SSLCA=
DB_SSLCERT=
DB_SSLKEY=

# === Sessions / Cache / Queue ===
# All use the database driver — no Redis required.
# If you prefer Redis, set SESSION_DRIVER=redis CACHE_STORE=redis QUEUE_CONNECTION=redis
# and provide REDIS_URL below.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=lax
SESSION_CONNECTION=
SESSION_STORE=
SESSION_COOKIE=tech360_session
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_DRIVER=database
CACHE_PREFIX=tech360_cache

# === Optional Redis ===
# If your server has Redis (127.0.0.1:6379) and you want to use it,
# uncomment and switch the drivers above to "redis".
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# === Mail ===
# Default: SMTP. To use Resend API instead, set MAIL_MAILER=resend and
# provide RESEND_API_KEY below (Resend supports SMTP at smtp.resend.com:587).
MAIL_MAILER=smtp
MAIL_URL=
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=noreply@bdtech360.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO=support@bdtech360.com

# Resend API (optional — for HTTP API mail driver)
RESEND_API_KEY=

# === AI Provider ===
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_API_URL=
AI_TIMEOUT=30
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.4

# Ollama alternative (uncomment for local AI):
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=

# === Webhook Secrets (HMAC verification) ===
# Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
AI_WEBHOOK_SECRET=

# === Payment Gateway ===
PAYMENT_GATEWAY=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# === Security ===
SECURE_DOWNLOAD_SALT=
SOURCE_CODE_STORAGE=private

# === Upload Directory ===
# Laravel default storage path. Override only if you need a custom path
# outside the project (e.g., /home/aloedu/storage/uploads).
# WARNING: If you set this, ensure the web server has write permissions.
# UPLOAD_DIR=/home/aloedu/storage/uploads

# === Optional integrations ===
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# === Backup ===
BACKUP_ENABLED=false
BACKUP_DISK=local
