// Tech360 Platform — Prisma schema (SQLite)
// AI-Powered Business Operating System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------

enum UserRole {
  SUPER_ADMIN
  MANAGER
  AGENT
  STAFF
  CLIENT
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  SOCIAL
  REFERRAL
  DIRECT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
}

enum Channel {
  EMAIL
  WHATSAPP
  CALL
  MEETING
  SOCIAL
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ScopeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK
  PAYPAL
  CRYPTO
}

enum ApprovalType {
  SCOPE
  PAYMENT
  CONTENT
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileCategory {
  CONTRACT
  DESIGN
  DELIVERABLE
  INVOICE
  OTHER
}

enum AgentStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum AgentRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum SocialChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ---------------- MODELS ----------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(STAFF)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff      Staff?
  auditLogs  AuditLog[]
  agentRuns  AgentRun[]
  approvals  Approval[]      @relation("ApprovalDecider")
  approvalsR Approval[]      @relation("ApprovalRequester")
  paymentsV  Payment[]       @relation("PaymentVerifier")
  scopesA    Scope[]         @relation("ScopeApprover")
  filesU     FileItem[]      @relation("FileUploader")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  source     LeadSource @default(WEBSITE)
  status     LeadStatus @default(NEW)
  score      Int        @default(50)
  message    String?
  projectId  String?
  assignedTo String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project        Project?       @relation(fields: [projectId], references: [id])
  communications Communication[]
  client         Client?

  
  @@index([source])
}

model Project {
  id        String        @id @default(cuid())
  name      String
  clientId  String?
  scope     String?
  status    ProjectStatus @default(PLANNING)
  budget    Float         @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  leads          Lead[]
  communications Communication[]
  scopes         Scope[]
  payments       Payment[]
  files          FileItem[]
  client    Client?  @relation(fields: [clientId], references: [id])
  tasks          Task[]
  invoices       Invoice[]
  meetings       Meeting[]
  evidence       Evidence[]
  reviews        Review[]
  milestones     ProjectMilestone[]
}

model Communication {
  id        String    @id @default(cuid())
  leadId    String?
  projectId String?
  channel   Channel
  direction Direction @default(INBOUND)
  subject   String
  body      String
  createdAt DateTime  @default(now())

  lead    Lead?    @relation(fields: [leadId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])
  clientId String?

  @@index([channel])
}

model Scope {
  id           String      @id @default(cuid())
  projectId    String
  title        String
  deliverables String // JSON-encoded list
  timeline     String
  budget       Float       @default(0)
  status       ScopeStatus @default(DRAFT)
  scopeVersion      String   @default("SOW-v1.0")
  termsAccepted     Boolean  @default(false)
  refundPolicyAccepted Boolean @default(false)
  previewAcknowledged Boolean @default(false)
  immutableSnapshot  String?  // JSON snapshot at approval time
  approvedByClient  String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])
  versions ScopeVersion[]
  clientId String?
  approver  User?   @relation("ScopeApprover", fields: [approvedBy], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  projectId     String
  amount        Float
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CARD)
  transactionId String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project  Project @relation(fields: [projectId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?
  verifier User?   @relation("PaymentVerifier", fields: [verifiedBy], references: [id])
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  entityId    String
  requestedBy String
  status      ApprovalStatus @default(PENDING)
  decisionBy  String?
  decisionAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  decider   User? @relation("ApprovalDecider", fields: [decisionBy], references: [id])
  requester User  @relation("ApprovalRequester", fields: [requestedBy], references: [id])
}

model FileItem {
  id         String       @id @default(cuid())
  name       String
  category   FileCategory @default(OTHER)
  projectId  String?
  sizeKb     Int          @default(0)
  storagePath String
  mimeType    String       @default("application/octet-stream")
  uploadedBy String?
  createdAt  DateTime     @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])
  clientId String?
  uploader User?   @relation("FileUploader", fields: [uploadedBy], references: [id])
}

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  role        UserRole @default(STAFF)
  permissions String   // pipe-separated
  department  String
  hourlyRate  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  content   String
  tags      String   // pipe-separated
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityType String
  entityId  String
  metadata  String   // JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType])
}

model Agent {
  id          String      @id @default(cuid())
  name        String
  role        String
  description String
  status      AgentStatus @default(ONLINE)
  skillPath   String      // AgentOS SKILL.md path
  lastAction  String?
  config      String      // JSON
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  runs AgentRun[]

  
}

model AgentRun {
  id         String         @id @default(cuid())
  agentId    String
  userId     String?
  input      String
  output     String?
  status     AgentRunStatus @default(RUNNING)
  durationMs Int            @default(0)
  createdAt  DateTime       @default(now())

  agent Agent @relation(fields: [agentId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([agentId])
}

model Conversation {
  id            String        @id @default(cuid())
  channel       SocialChannel
  contactName   String
  contactHandle String
  lastMessageAt DateTime      @default(now())
  unreadCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages Message[]

  @@index([channel])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  channel        SocialChannel
  direction      Direction     @default(INBOUND)
  from           String
  to             String
  body           String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Workflow {
  id            String   @id @default(cuid())
  name          String
  description   String
  triggerType   String
  triggerConfig String   // JSON
  nodes         String   // JSON
  edges         String   // JSON
  active        Boolean  @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs WorkflowRun[]
}

model WorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  status      WorkflowRunStatus @default(RUNNING)
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  logs        String
  createdAt   DateTime          @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@index([workflowId])
}

model Webhook {
  id          String    @id @default(cuid())
  name        String
  endpoint    String
  channel     String
  secret      String
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String
  updatedAt DateTime @updatedAt
}

// =====================================================================
// AI WORKFORCE SYSTEM — added in task AI-WORKFORCE-BUILD
// 50+ models covering: registry, workflow/execution, memory/RAG,
// permissions/policy, models/routing, evaluation/monitoring, testing,
// audit/logging/HITL, jobs/queues/training.
// SQLite-compatible: JSON stored as String, no arrays, no @db.Text.
// =====================================================================

// ---------------- CORE REGISTRY ----------------

model AICompany {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  departments AIDepartment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIDepartment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  companyId   String
  company     AICompany @relation(fields: [companyId], references: [id])
  agents      AIAgent[]
  sops        AISOP[]
  dcc         AIDepartmentCapabilityCertification?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([companyId])
}

model AIAgent {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  departmentId       String
  department         AIDepartment @relation(fields: [departmentId], references: [id])
  role               String
  description        String
  businessPurpose    String
  responsibilities   String
  inputSchema        String
  outputSchema       String
  systemInstructions String
  version            Int      @default(1)
  status             String   @default("ACTIVE")
  skillPath          String
  modelRoutingPolicyId String?
  modelRoutingPolicy AIModelRoutingPolicy? @relation(fields: [modelRoutingPolicyId], references: [id])
  fallbackPolicyId   String?
  fallbackPolicy     AIFallbackPolicy? @relation(fields: [fallbackPolicyId], references: [id])
  memoryPolicy       String   @default("{\"type\":\"session\",\"retentionDays\":30}")
  ragPolicy          String   @default("{\"enabled\":false}")
  safetyPolicy       String   @default("{\"maxOutputTokens\":4096,\"allowExternalCalls\":false}")
  humanApprovalRequired Boolean @default(false)
  escalationRules    String   @default("[]")
  timeoutPolicy      Int      @default(60)
  retryPolicy        String   @default("{\"maxRetries\":2,\"backoffMs\":1000}")
  auditPolicy        String   @default("{\"logInput\":true,\"logOutput\":true}")
  capabilities       AIAgentCapability[]
  skills             AIAgentSkill[]
  prompts            AIPrompt[]
  tools              AIAgentToolPermission[]
  permissions        AIAgentPermission[]
  memory             AIAgentMemory[]
  executions         AITaskExecution[]
  feedback           AIAgentFeedback[]
  incidents          AIAgentIncident[]
  evaluations        AIEvaluation[]
  approvalRequests   AIApprovalRequest[]
  versions           AIAgentVersion[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([departmentId])
  
  @@index([role])
}

model AIAgentVersion {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  version     Int
  snapshot    String
  changelog   String?
  createdBy   String?
  createdAt   DateTime @default(now())
  @@index([agentId])
}

model AIAgentCapability {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  name        String
  description String?
  @@index([agentId])
}

model AIAgentSkill {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  skillId     String
  skill       AISkill  @relation(fields: [skillId], references: [id])
  proficiency String   @default("intermediate")
  @@index([agentId])
  @@index([skillId])
}

model AISkill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String
  inputSchema String
  outputSchema String
  instructions String
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  agents      AIAgentSkill[]
  versions    AISkillVersion[]
  tests       AISkillTest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category])
  
}

model AISkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  skill       AISkill  @relation(fields: [skillId], references: [id])
  version     Int
  snapshot    String
  changelog   String?
  createdAt   DateTime @default(now())
  @@index([skillId])
}

model AIPrompt {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  slug        String
  name        String
  description String
  template    String
  variables   String
  promptType  String   @default("system")
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  tests       AIPromptTest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([agentId, slug])
  @@index([agentId])
  
}

model AIPromptVersion {
  id          String   @id @default(cuid())
  promptId    String
  version     Int
  snapshot    String
  changelog   String?
  createdAt   DateTime @default(now())
  @@index([promptId])
}

model AISOP {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  departmentId String?
  department  AIDepartment? @relation(fields: [departmentId], references: [id])
  steps       String
  triggerConditions String
  successCriteria String
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  agentIds    String
  tests       AISOPTest[]
  versions    AISOPVersion[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([departmentId])
}

model AISOPVersion {
  id          String   @id @default(cuid())
  sopId       String
  sop         AISOP    @relation(fields: [sopId], references: [id])
  version     Int
  snapshot    String
  changelog   String?
  createdAt   DateTime @default(now())
  @@index([sopId])
}

// ---------------- WORKFLOW & EXECUTION ----------------

model AIWorkflow {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  triggerType String
  triggerConfig String
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  steps       AIWorkflowStep[]
  executions  AIWorkflowExecution[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIWorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    AIWorkflow @relation(fields: [workflowId], references: [id])
  order       Int
  name        String
  agentId     String?
  action      String
  config      String
  nextStepId  String?
  @@index([workflowId])
}

model AITask {
  id          String   @id @default(cuid())
  agentId     String
  input       String
  status      String   @default("PENDING")
  priority    Int      @default(5)
  scheduledFor DateTime?
  executions  AITaskExecution[]
  createdAt   DateTime @default(now())
  @@index([agentId])
  
}

model AITaskExecution {
  id          String   @id @default(cuid())
  taskId      String?
  task        AITask?  @relation(fields: [taskId], references: [id])
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  input       String
  output      String?
  status      String   @default("RUNNING")
  durationMs  Int?
  tokenInput  Int?
  tokenOutput Int?
  modelUsed   String?
  errorMessage String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  results     AITaskResult[]
  logs        AIExecutionLog[]
  @@index([agentId])
  
}

model AITaskResult {
  id          String   @id @default(cuid())
  executionId String
  execution   AITaskExecution @relation(fields: [executionId], references: [id])
  key         String
  value       String
  type        String
  @@index([executionId])
}

model AIWorkflowExecution {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    AIWorkflow @relation(fields: [workflowId], references: [id])
  status      String   @default("RUNNING")
  input       String
  output      String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  steps       AIWorkflowExecutionStep[]
  @@index([workflowId])
}

model AIWorkflowExecutionStep {
  id          String   @id @default(cuid())
  executionId String
  execution   AIWorkflowExecution @relation(fields: [executionId], references: [id])
  stepId      String
  status      String   @default("PENDING")
  output      String?
  startedAt   DateTime?
  completedAt DateTime?
  @@index([executionId])
}

// ---------------- MEMORY & RAG ----------------

model AIAgentMemory {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  type        String
  key         String
  value       String
  metadata    String
  expiresAt   DateTime?
  chunks      AIMemoryChunk[]
  createdAt   DateTime @default(now())
  @@index([agentId])
  @@index([type])
}

model AIMemoryChunk {
  id          String   @id @default(cuid())
  memoryId    String
  memory      AIAgentMemory @relation(fields: [memoryId], references: [id])
  content     String
  embedding   String?
  chunkIndex  Int
  @@index([memoryId])
}

model AIRAGDocument {
  id          String   @id @default(cuid())
  source      String
  sourceRef   String?
  title       String
  content     String
  metadata    String
  chunks      AIRAGChunk[]
  status      String   @default("INDEXED")
  createdAt   DateTime @default(now())
  
}

model AIRAGChunk {
  id          String   @id @default(cuid())
  documentId  String
  document    AIRAGDocument @relation(fields: [documentId], references: [id])
  content     String
  embedding   String?
  chunkIndex  Int
  @@index([documentId])
}

model AIKnowledgeSource {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  type        String
  config      String
  status      String   @default("ACTIVE")
  versions    AIKnowledgeVersion[]
  createdAt   DateTime @default(now())
}

model AIKnowledgeVersion {
  id          String   @id @default(cuid())
  sourceId    String
  source      AIKnowledgeSource @relation(fields: [sourceId], references: [id])
  version     Int
  snapshot    String
  createdAt   DateTime @default(now())
  @@index([sourceId])
}

model AIEmbedding {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  embedding   String
  model       String
  dimensions  Int
  createdAt   DateTime @default(now())
  @@index([entityType, entityId])
}

// ---------------- PERMISSIONS & POLICY ----------------

model AIAgentPermission {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  resource    String
  action      String
  constraints String   @default("{}")
  grantedBy   String?
  createdAt   DateTime @default(now())
  @@unique([agentId, resource, action])
  @@index([agentId])
}

model AIAgentPolicy {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  type        String
  rules       String
  version     Int      @default(1)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}

model AIAgentTool {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  inputSchema String
  outputSchema String
  type        String
  config      String
  status      String   @default("ACTIVE")
  agents      AIAgentToolPermission[]
  createdAt   DateTime @default(now())
}

model AIAgentToolPermission {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  toolId      String
  tool        AIAgentTool @relation(fields: [toolId], references: [id])
  grantedBy   String?
  createdAt   DateTime @default(now())
  @@unique([agentId, toolId])
}

// ---------------- MODELS & ROUTING ----------------

model AIModelProvider {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  apiBase     String?
  apiKeyEnv   String?
  status      String   @default("ACTIVE")
  models      AIModel[]
  createdAt   DateTime @default(now())
}

model AIModel {
  id          String   @id @default(cuid())
  providerId  String
  provider    AIModelProvider @relation(fields: [providerId], references: [id])
  slug        String   @unique
  name        String
  contextWindow Int
  inputCostPer1k Float?
  outputCostPer1k Float?
  capabilities String
  status      String   @default("ACTIVE")
  routingPolicies AIModelRoutingPolicy[]
  capabilities_rel AIModelCapability[]
  createdAt   DateTime @default(now())
  @@index([providerId])
}

model AIModelCapability {
  id          String   @id @default(cuid())
  modelId     String
  model       AIModel  @relation(fields: [modelId], references: [id])
  capability  String
  score       Float    @default(1.0)
  @@index([modelId])
}

model AIModelRoutingPolicy {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  primaryModelId String?
  primaryModel AIModel? @relation(fields: [primaryModelId], references: [id])
  fallbackModelIds String
  routingRules String
  costLimitPerRequest Float?
  agents      AIAgent[]
  createdAt   DateTime @default(now())
}

model AIFallbackPolicy {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  strategy    String
  fallbackChain String
  maxRetries  Int      @default(2)
  backoffMs   Int      @default(1000)
  agents      AIAgent[]
  createdAt   DateTime @default(now())
}

// ---------------- EVALUATION & MONITORING ----------------

model AIEvaluation {
  id          String   @id @default(cuid())
  agentId     String
  agent       AIAgent  @relation(fields: [agentId], references: [id])
  name        String
  description String?
  status      String   @default("DRAFT")
  runs        AIEvaluationRun[]
  metrics     AIEvaluationMetric[]
  createdAt   DateTime @default(now())
  @@index([agentId])
}

model AIEvaluationRun {
