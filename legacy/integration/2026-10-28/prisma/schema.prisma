model CommunicationLedger {
  id              String   @id @default(cuid())
  ledgerId        String   @unique  // LEDGER-2026-000001
  clientId        String?
  projectId       String?
  channel         String   // WHATSAPP, EMAIL, SMS, WEBSITE, FACEBOOK, INSTAGRAM, LINKEDIN, X, MESSENGER, MANUAL
  direction       String   // INBOUND, OUTBOUND
  sender          String?
  recipient       String?
  messageBody     String
  attachmentIds   String   @default("[]")  // JSON array
  timestamp       DateTime @default(now())
  deliveryStatus  String   @default("PENDING")  // PENDING, SENT, DELIVERED, READ, FAILED
  readStatus      Boolean  @default(false)
  sourceMessageId String?  // external message ID from WhatsApp/email
  staffUserId     String?
  approvalId      String?
  aiProcessed     Boolean  @default(false)
  aiClassification String?  // business type, intent, etc.
  nextAction      String?  // next recommended action
  createdAt       DateTime @default(now())
  @@index([clientId])
  @@index([channel])
  @@index([timestamp])
}

model StructuredApproval {
  id              String   @id @default(cuid())
  approvalId      String   @unique  // APR-2026-000001
  clientId        String
  projectId       String?
  scopeVersion    String   // SOW-v1.3
  approvalType    String   // SCOPE, PREVIEW, PAYMENT, DELIVERY, CHANGE_REQUEST
  approvalText    String   // "I APPROVE THE SCOPE"
  emailAddress    String
  messageId       String?  // email message ID
  timestamp       DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  approvedBy      String   // client name
  status          String   @default("PENDING")  // PENDING, APPROVED, REJECTED, EXPIRED
  scopeSnapshot   String   // JSON of full scope at approval time
  createdAt       DateTime @default(now())
  @@index([clientId])
  
}

model DeliveryRelease {
  id              String   @id @default(cuid())
  deliveryId      String   @unique  // DEL-2026-000001
  clientId        String
  projectId       String?
  paymentStatus   String   // PENDING, VERIFIED
