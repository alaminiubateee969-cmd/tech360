  adminApproval   String   @default("PENDING")  // PENDING, APPROVED, REJECTED
  adminApprovedBy String?
  adminApprovedAt DateTime?
  packageHash     String?  // SHA-256 of delivery package
  storagePath     String?  // private storage path
  signedUrl       String?  // short-lived signed URL
  accessToken     String?
  signedUrlExpiry DateTime?
  clientConfirmed Boolean  @default(false)
  clientConfirmedAt DateTime?
  passwordRotationComplete Boolean @default(false)
  accessStatus    String   @default("TECH360_CONTROLLED")  // TECH360_CONTROLLED, CLIENT_CONTROLLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([clientId])
  @@index([adminApproval])
  
}

