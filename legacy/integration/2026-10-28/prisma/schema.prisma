  totalHours      Int
  blendedRate     Float
  estimatedValue  Float
  contingency     Float    @default(0.10)
  finalQuote      Float
  adminApproved   Boolean  @default(false)
  adminApprovedBy String?
  createdAt       DateTime @default(now())
  @@index([clientId])
}

// ============================================================
// COMMERCIAL WORKFLOW — TECH360 LLC
// State machine, scope versioning, payment verification, refund
// ============================================================

model RefundRequest {
  id              String   @id @default(cuid())
  refundId        String   @unique  // REF-2026-000001
  clientId        String
  projectId       String?
  invoiceId       String?
  paymentRef      String?
  paymentDate     DateTime?
  reason          String
  description     String?
  status          String   @default("REFUND_REQUESTED")  // REFUND_REQUESTED, REFUND_REVIEW, APPROVED, DENIED, REFUNDED
  reviewedBy      String?
  reviewedAt      DateTime?
  decision        String?
  resolution      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([clientId])
  @@index([status])
}

model CommercialAuditLog {
  id              String   @id @default(cuid())
  clientId        String?
  projectId       String?
  scopeId         String?
  paymentId       String?
  action          String   // scope_created, scope_sent, scope_approved, payment_verified, delivery_released, etc.
  actorType       String   // client, admin, system
  actorId         String?
  details         String   @default("{}")  // JSON
  ipAddress       String?
  userAgent       String?
  timestamp       DateTime @default(now())
  @@index([clientId])
  @@index([projectId])
  @@index([action])
}

// ============================================================
// MARKETING ATTRIBUTION — Privacy-compliant first-party tracking
// Anonymous visitor IDs, consent management, UTM capture
// ============================================================

model Visitor {
  id                    String   @id @default(cuid())
  visitorId             String   @unique  // vid_xxxxx (anonymous, NOT personal identity)
  sessionId             String?
  firstSeenAt           DateTime @default(now())
  lastSeenAt            DateTime @default(now())
  landingPage           String?
  referrer              String?
  firstTouchSource       String?  // Facebook, LinkedIn, Google, YouTube, Direct, Referral
  lastTouchSource       String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm                String?
  pageViews             Int      @default(0)
  serviceViews          Int      @default(0)
  caseStudyViews        Int      @default(0)
  whatsappClicks        Int      @default(0)
  projectBriefStarted   Boolean  @default(false)
  projectBriefSubmitted Boolean  @default(false)
  meetingRequest        Boolean  @default(false)
  consentStatus         String   @default("pending")  // pending, granted, denied
  consentAt             DateTime?
  consentVersion        String   @default("1.0")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([utmSource])
  @@index([consentStatus])
}

model ConsentRecord {
  id            String   @id @default(cuid())
  visitorId     String
  consentStatus String   // granted, denied, revoked
  consentVersion String  @default("1.0")
  categories    String?  // JSON array: ["necessary","analytics","marketing"]
  ipAddress     String?  // anonymized (last octet zeroed)
  userAgent     String?
  consentAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  @@index([visitorId])
}

model MarketingEvent {
  id          String   @id @default(cuid())
  visitorId   String
  sessionId   String?
  eventName   String   // page_view, service_view, project_brief_submit, whatsapp_click, etc.
  page        String?
  service     String?
  industry    String?
  projectType String?
  utmSource   String?
  utmCampaign String?
  consentStatus String?
  createdAt   DateTime @default(now())
  @@index([visitorId])
  @@index([eventName])
  @@index([createdAt])
}

model ProjectBrief {
  id                  String   @id @default(cuid())
  briefId             String   @unique  // BRF-2026-000001
  visitorId           String?
  name                String
  company             String?
  businessType        String?
  projectType         String?
  email               String
  whatsapp            String?
  currentWebsite      String?
  projectDescription  String
  requiredFeatures    String?
  expectedTimeline    String?
  referenceWebsite    String?
  attachmentPath      String?
  attachmentHash       String?
  firstTouchSource    String?
  lastTouchSource     String?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?
  landingPage         String?
  referrer            String?
  consentStatus       String?
  ipAddress           String?
  userAgent           String?
  status              String   @default("new")  // new, contacted, qualified, converted, archived
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([email])
  @@index([status])
}

model MeetingRequest {
  id              String   @id @default(cuid())
  meetingId       String   @unique  // MTG-2026-000001
  visitorId       String?
  name            String
  company         String?
  email           String
  whatsapp        String?
  businessType    String?
  projectType     String?
  preferredDate   DateTime?
  preferredTime   String?
  timezone        String?
  message         String?
  utmSource       String?
  utmCampaign     String?
  consentStatus   String?
  ipAddress       String?
  userAgent       String?
  status          String   @default("requested")  // requested, scheduled, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([status])
}
