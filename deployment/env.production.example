# ============================================================
# TECH360 PLATFORM — environment template
# NEVER commit real values. In production use Google Secret
# Manager (see deployment/cloudbuild.yaml).
# ============================================================

# --- Core ---
DATABASE_URL="file:./db/custom.db"          # production: Cloud SQL connection string
APP_PUBLIC_URL="https://bdtech360.com"      # used for preview/handover links
NODE_ENV=production

# --- Admin bootstrap (seeded on first run; must-change enforced) ---
ADMIN_EMAIL=admin@bdtech360.com
ADMIN_PASSWORD=change-me-immediately

# --- n8n automation bridge (automation.bdtech360.com) ---
N8N_WEBHOOK_SECRET=generate-a-long-random-secret
N8N_WEBHOOK_BASE=https://automation.bdtech360.com

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tech360 <info@bdtech360.com>"

# --- SMS provider (generic Bearer API) ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Tech360

# --- Social platforms (outbound where supported) ---
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# --- Google Cloud (production) ---
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
