# ============================================================
# LEGACY Google Cloud Run environment template (names/placeholders only).
# Not the supported Tech360 production environment; Hostinger's Node.js Web
# App uses the root .env.example as the variable-name inventory. Never commit
# real values. This file is retained for historical/client deployment work.
# ============================================================

# --- Core ---
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME" # MySQL; set the real value only in the secret manager
APP_PUBLIC_URL="https://bdtech360.com"      # used for preview/handover links
NODE_ENV=production

# --- Admin bootstrap (seeded on first run; must-change enforced) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- n8n automation bridge (automation.bdtech360.com) ---
N8N_WEBHOOK_SECRET=generate-a-long-random-secret
N8N_WEBHOOK_BASE=https://automation.bdtech360.com

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tech360 <info@bdtech360.com>"

# --- SMS provider (generic Bearer API) ---
# Free SMS (open source httpSMS — sends through your own Android phone's SIM; https://httpsms.com or self-host)
HTTPSMS_API_KEY=
HTTPSMS_FROM=
HTTPSMS_BASE_URL=
# Client portal sign-in codes: auto | required | off ; preferred channel: email | whatsapp | sms
PORTAL_OTP=
PORTAL_OTP_CHANNEL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Tech360

# --- Social platforms (outbound where supported) ---
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# --- Google Cloud (production) ---
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
