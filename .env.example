# TECH360 production environment variable names only.
# Set values in Hostinger -> Node.js Web App -> Environment Variables.
# This file intentionally contains no sample URLs, credentials, or secrets.

# Core runtime (required)
DATABASE_URL=
APP_PUBLIC_URL=
APP_ORIGIN=
NODE_ENV=

# Independent random secrets (at least 32 characters each)
SESSION_SECRET=
OPS_SECRET=
PORTAL_SECRET=
# HMAC key for verified identity lookup; preserve it across deploys or identity links cannot be resolved.
IDENTITY_HASH_SECRET=

# Optional integrations (blank disables the integration)
NOTIFY_RELAY_TOKEN=
NOTIFY_RELAY_URL=

# First-boot Super Admin bootstrap only; remove ADMIN_PASSWORD after seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=

# First-boot Admin (operations) bootstrap — optional second console login.
# Set both to seed an ADMIN-role account alongside the Super Admin;
# remove STAFF_ADMIN_PASSWORD after seeding.
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=

# Operations and business settings
OPS_INTERVAL_SEC=
PLATFORM_URL=
PREVIEW_TTL_DAYS=
# Optional; blank keeps TECH-YYYY-NNNNNN client identifiers.
CLIENT_ID_PREFIX=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_TRANSFER_DETAILS=
MANUAL_PAYMENT_INSTRUCTIONS=
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
# PayPal and SSLCommerz adapters are NOT IMPLEMENTED (INTEGRATION_NOT_BUILT).
# Setting these variables does not enable those gateways; Settings refuses to
# mark them live. Use Stripe, bank transfer, bKash or Nagad in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Communications
# PRIVATE CRM MESSAGING ONLY. TECH360 publishes no public WhatsApp number or
# chat link (owner decision 2026-10-24); these credentials power the private
# inbound/outbound adapter, never a public contact route.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Dedicated inbound email hook key; send raw-body HMAC or x-email-webhook-secret.
EMAIL_WEBHOOK_SECRET=
HTTPSMS_API_KEY=
HTTPSMS_FROM=
HTTPSMS_BASE_URL=
# Production always requires OTP; PORTAL_OTP=off is honored only outside production.
PORTAL_OTP=
PORTAL_OTP_CHANNEL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# AI router (planned; values do not enable a provider until its adapter is implemented)
AI_ROUTER_ENABLED=false
AI_PROVIDER_ORDER=
AI_ALLOW_PAID_FALLBACK=false
AI_DAILY_BUDGET_USD=0
AI_MAX_RETRIES=2
AI_EXTERNAL_DATA_POLICY=restricted
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Website live chat (planned: public widget ID is not a secret)
WEBSITE_CHAT_ENABLED=true
WEBSITE_CHAT_ALLOWED_ORIGINS=
WEBSITE_CHAT_RATE_LIMIT_PER_MINUTE=

# Social account OAuth/token vault is not implemented by these placeholder variables.
# Connect accounts through an authorized OAuth flow when each provider adapter is ready.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# n8n bridge
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE=

# Media Studio providers (blank = honest NOT_CONFIGURED / RENDER_NOT_CONFIGURED)
MEDIA_RENDER_PROVIDER=
MEDIA_RENDER_API_KEY=
TTS_PROVIDER_URL=
TTS_API_KEY=
MUSIC_PROVIDER_URL=

# Call & SMS centre (device gateway / Twilio / SIP softphone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SIP_DOMAIN=

# Communication pipeline — the booking link a client uses to take a
# scope-explaining call (stage 5A of the client journey).
# Defaults to https://bdtech360.com/#contact when blank.
MEETING_BOOKING_URL=

# Hostinger Mail API (optional). Email stays on SMTP unless HOSTINGER_MAIL_ENABLED=true.
# With it set, every variable below must validate or email sends are refused (never silent SMTP fallback).
# Values are never committed. Create the token in hPanel with the narrowest scope; do not reuse other tokens.
HOSTINGER_MAIL_ENABLED=
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=
HOSTINGER_MAIL_FROM_ADDRESS=
# Optional. Only the one-time secret that Hostinger returns when a webhook is configured by an authorized person.
HOSTINGER_MAIL_WEBHOOK_SECRET=

# Optional: zero-price OpenRouter assistant in Admin / Super Admin Command Center.
# Server only. Never use NEXT_PUBLIC_ for this key. Free routes still have quotas.
OPENROUTER_API_KEY=
