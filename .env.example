# ============================================================
# TECH360 PLATFORM — environment template (SAFE — placeholder
# values only; never commit real secrets. Copy to .env for dev
# or .env.production on the VPS / Secret Manager in cloud.)
#
# Every optional integration below follows the HONEST CHANNEL
# principle: when the value is empty, the platform shows the
# channel/gateway as NOT_CONFIGURED / CONFIGURATION REQUIRED
# and refuses to send/settle through it — it never fakes success.
# ============================================================

# --- Core (required) ---
DATABASE_URL="file:./db/custom.db"
# Public base URL used in preview / handover / invoice payment links
APP_PUBLIC_URL="http://localhost:3000"
# Same-origin override used by Stripe checkout success/cancel URLs
APP_ORIGIN="http://localhost:3000"
NODE_ENV=development

# --- Secrets (required in production — generate long random values) ---
# Session + CSRF + portal token signing. DEV DEFAULTS MUST BE REPLACED.
SESSION_SECRET="generate-a-long-random-secret"
OPS_SECRET="generate-a-long-random-secret"          # Cloud Scheduler / ops loop trigger auth
PORTAL_SECRET="generate-a-long-random-secret"       # client portal session tokens (falls back to OPS_SECRET)
NOTIFY_RELAY_TOKEN="generate-a-long-random-secret"  # websocket notify-relay auth
NOTIFY_RELAY_URL="ws://localhost:3032"              # platform → relay ping target

# --- Admin bootstrap (seeded on first boot only; must-change enforced) ---
ADMIN_EMAIL="admin@bdtech360.com"
ADMIN_PASSWORD="change-me-immediately"

# --- AI operations loop (dev mini-service) ---
OPS_INTERVAL_SEC=90
PLATFORM_URL="http://localhost:3000"

# --- Business rules ---
PREVIEW_TTL_DAYS=7

# ============================================================
# PAYMENT GATEWAYS (credentials NEVER in the DB — env only)
# Switches (ON/OFF + sandbox/production) are managed live by the
# Super Admin in Settings → Payment Gateways. See PAYMENT.md.
# ============================================================

# --- Stripe (real REST checkout + HMAC-verified webhook) ---
STRIPE_SECRET_KEY=""            # sk_test_... / sk_live_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... from the Stripe dashboard endpoint

# --- Platform-verified local methods (instructions shown on invoices) ---
BANK_TRANSFER_DETAILS=""        # e.g. "TECH360 LLC · Merchants Bank · ACCT 123456789"
BKASH_MERCHANT_NUMBER=""        # e.g. "+8801XXXXXXXXX"
NAGAD_MERCHANT_NUMBER=""        # e.g. "+8801XXXXXXXXX"

# --- Not-yet-integrated gateway checkouts (honest INTEGRATION_NOT_BUILT) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# ============================================================
# COMMUNICATION CHANNELS (all optional — empty = NOT_CONFIGURED)
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tech360 <info@bdtech360.com>"

# --- SMS provider (generic Bearer API) ---
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="Tech360"

# --- Social platforms (outbound publishing where supported) ---
FACEBOOK_PAGE_TOKEN=""
INSTAGRAM_TOKEN=""
LINKEDIN_TOKEN=""
X_TOKEN=""
SOCIAL_WEBHOOK_SECRET=""

# --- n8n automation bridge ---
N8N_WEBHOOK_SECRET=""
N8N_WEBHOOK_BASE=""

# ============================================================
# PRODUCTION (Google Cloud Run path — see deployment/ folder;
# VPS path uses the same vars as above plus:)
# ============================================================
# GCS_BUCKET=""
# GOOGLE_CLOUD_PROJECT=""
# GOOGLE_CLOUD_REGION="us-central1"
