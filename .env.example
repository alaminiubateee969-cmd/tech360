# TECH360 production environment variable names only.
# Set values in Hostinger -> Node.js Web App -> Environment Variables.
# This file intentionally contains no sample URLs, credentials, or secrets.

# Core runtime (required)
DATABASE_URL=
APP_PUBLIC_URL=
APP_ORIGIN=
NODE_ENV=

# Independent random secrets (at least 32 characters each)
SESSION_SECRET=
OPS_SECRET=
PORTAL_SECRET=

# Optional integrations (blank disables the integration)
NOTIFY_RELAY_TOKEN=
NOTIFY_RELAY_URL=

# First-boot Super Admin bootstrap only; remove ADMIN_PASSWORD after seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=

# First-boot Admin (operations) bootstrap — optional second console login.
# Set both to seed an ADMIN-role account alongside the Super Admin;
# remove STAFF_ADMIN_PASSWORD after seeding.
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=

# Operations and business settings
OPS_INTERVAL_SEC=
PLATFORM_URL=
PREVIEW_TTL_DAYS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_TRANSFER_DETAILS=
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Communications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HTTPSMS_API_KEY=
HTTPSMS_FROM=
HTTPSMS_BASE_URL=
PORTAL_OTP=
PORTAL_OTP_CHANNEL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# Marketing Dashboard — social publishing (host-only secrets; set in
# hPanel/host env, NEVER in chat or git). OAuth/API tokens keep
# working after account password changes; see docs/MARKETING_DASHBOARD.md
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_BUSINESS_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
X_API_SECRET=
X_API_KEY=
X_ACCESS_TOKEN_SECRET=
YOUTUBE_CHANNEL_ID=
TIKTOK_ACCESS_TOKEN=
X_ACCESS_TOKEN=

# Internal automation models — FREE tier (OpenRouter). When set, the
# agent engine tries openrouter/free + curated :free models in order
# before the platform SDK. Blank = platform SDK only.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Shared AI Gateway (see .env.ai-gateway.example + docs/AI_GATEWAY.md).
# AgentOS calls the gateway only when BOTH are set; blank = direct chain.
AI_GATEWAY_BASE_URL=
AGENTOS_GATEWAY_TOKEN=

YOUTUBE_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# n8n bridge
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE=

# Media Studio providers (blank = honest NOT_CONFIGURED / RENDER_NOT_CONFIGURED)
MEDIA_RENDER_PROVIDER=
MEDIA_RENDER_API_KEY=
TTS_PROVIDER_URL=
TTS_API_KEY=
MUSIC_PROVIDER_URL=

# Call & SMS centre (device gateway / Twilio / SIP softphone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SIP_DOMAIN=
