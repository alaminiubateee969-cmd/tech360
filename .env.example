# TECH360 production environment variable names only.
# Set values in Hostinger -> Node.js Web App -> Environment Variables.
# This file intentionally contains no sample URLs, credentials, or secrets.

# Core runtime (required)
DATABASE_URL=
APP_PUBLIC_URL=
APP_ORIGIN=
NODE_ENV=

# Independent random secrets (at least 32 characters each)
SESSION_SECRET=
OPS_SECRET=
PORTAL_SECRET=

# Optional integrations (blank disables the integration)
NOTIFY_RELAY_TOKEN=
NOTIFY_RELAY_URL=

# First-boot Super Admin bootstrap only; remove ADMIN_PASSWORD after seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Operations and business settings
OPS_INTERVAL_SEC=
PLATFORM_URL=
PREVIEW_TTL_DAYS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_TRANSFER_DETAILS=
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Communications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HTTPSMS_API_KEY=
HTTPSMS_FROM=
HTTPSMS_BASE_URL=
PORTAL_OTP=
PORTAL_OTP_CHANNEL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# n8n bridge
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE=
