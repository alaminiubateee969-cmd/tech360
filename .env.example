# TECH360 production environment variable names only.
# Set values in Hostinger -> Node.js Web App -> Environment Variables.
# This file intentionally contains no sample URLs, credentials, or secrets.

# Core runtime (required)
DATABASE_URL=
APP_PUBLIC_URL=
APP_ORIGIN=
NODE_ENV=

# Independent random secrets (at least 32 characters each)
SESSION_SECRET=
OPS_SECRET=
PORTAL_SECRET=

# Optional integrations (blank disables the integration)
NOTIFY_RELAY_TOKEN=
NOTIFY_RELAY_URL=

# First-boot Super Admin bootstrap only; remove ADMIN_PASSWORD after seeding
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Operations and business settings
OPS_INTERVAL_SEC=
PLATFORM_URL=
PREVIEW_TTL_DAYS=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BANK_TRANSFER_DETAILS=
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Communications
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
HTTPSMS_API_KEY=
HTTPSMS_FROM=
HTTPSMS_BASE_URL=
PORTAL_OTP=
PORTAL_OTP_CHANNEL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_TOKEN=
LINKEDIN_TOKEN=
X_TOKEN=
SOCIAL_WEBHOOK_SECRET=

# AI router (planned; values do not enable a provider until its adapter is implemented)
AI_ROUTER_ENABLED=false
AI_PROVIDER_ORDER=
AI_ALLOW_PAID_FALLBACK=false
AI_DAILY_BUDGET_USD=0
AI_MAX_RETRIES=2
AI_EXTERNAL_DATA_POLICY=restricted
OLLAMA_BASE_URL=
OLLAMA_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Website live chat (planned: public widget ID is not a secret)
WEBSITE_CHAT_ENABLED=true
WEBSITE_CHAT_ALLOWED_ORIGINS=
WEBSITE_CHAT_RATE_LIMIT_PER_MINUTE=

# Social account OAuth/token vault is not implemented by these placeholder variables.
# Connect accounts through an authorized OAuth flow when each provider adapter is ready.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# n8n bridge
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_BASE=

# Media Studio providers (blank = honest NOT_CONFIGURED / RENDER_NOT_CONFIGURED)
MEDIA_RENDER_PROVIDER=
MEDIA_RENDER_API_KEY=
TTS_PROVIDER_URL=
TTS_API_KEY=
MUSIC_PROVIDER_URL=

# Call & SMS centre (device gateway / Twilio / SIP softphone)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SIP_DOMAIN=
