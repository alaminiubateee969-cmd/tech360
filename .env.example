# TECH360 production environment template
# Copy the variable names into Hostinger -> Node.js Web App -> Environment Variables.
# Never commit a production .env file or put real credentials here.
# Empty optional integration values intentionally disable that integration safely.

# Core (required)
DATABASE_URL="mysql://USER:PASSWORD@ACTUAL_HOST:3306/DATABASE"
APP_PUBLIC_URL="https://bdtech360.com"
APP_ORIGIN="https://bdtech360.com"
NODE_ENV=production

# Required secrets (generate unique random values; do not use these placeholders)
SESSION_SECRET=""
OPS_SECRET=""
PORTAL_SECRET=""
NOTIFY_RELAY_TOKEN=""
NOTIFY_RELAY_URL=""

# First-boot Super Admin bootstrap (required for initial seed only; change password at first login)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional operations and business settings
OPS_INTERVAL_SEC="90"
PLATFORM_URL="https://bdtech360.com"
PREVIEW_TTL_DAYS="7"

# Payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BANK_TRANSFER_DETAILS=""
BKASH_MERCHANT_NUMBER=""
NAGAD_MERCHANT_NUMBER=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# Communications
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tech360 <info@bdtech360.com>"
# Free SMS (open source httpSMS — sends through your own Android phone's SIM; https://httpsms.com or self-host)
HTTPSMS_API_KEY=""
HTTPSMS_FROM=""
HTTPSMS_BASE_URL=""
# Client portal sign-in codes: auto | required | off ; preferred channel: email | whatsapp | sms
PORTAL_OTP=""
PORTAL_OTP_CHANNEL=""
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="Tech360"
FACEBOOK_PAGE_TOKEN=""
INSTAGRAM_TOKEN=""
LINKEDIN_TOKEN=""
X_TOKEN=""
SOCIAL_WEBHOOK_SECRET=""

# n8n bridge
N8N_WEBHOOK_SECRET=""
N8N_WEBHOOK_BASE=""
