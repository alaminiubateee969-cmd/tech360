# ============================================================
# TECH360 Shared AI Gateway — example environment.
# Copy to a PRIVATE env file outside version control.
# NEVER commit real application tokens or provider keys.
# Generate an app token:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store ONLY its SHA-256 hex digest in AI_GATEWAY_APPS:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" YOUR_TOKEN
# ============================================================

AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=3180

# JSON app registry. tokenSha256 must be 64 lowercase hex chars.
# allowExternal defaults to false; allowedModels empty = any model
# the route policy permits; requestsPerMinute is per app.
# AI_GATEWAY_APPS=[{"id":"crm","tokenSha256":"<64-hex>","dataClassification":"INTERNAL","allowExternal":false,"allowedModels":["openrouter/free"],"requestsPerMinute":60},{"id":"agentos","tokenSha256":"<64-hex>","dataClassification":"INTERNAL","allowExternal":false,"allowedModels":["openrouter/free"],"requestsPerMinute":120}]

AI_GATEWAY_REQUEST_TIMEOUT_MS=120000
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BASE_MS=120
AI_GATEWAY_CIRCUIT_BREAKER_ENABLED=true
AI_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
AI_GATEWAY_CIRCUIT_RESET_MS=30000
AI_GATEWAY_MAX_CONCURRENT_REQUESTS=8
AI_GATEWAY_MAX_INPUT_BYTES=1048576
AI_GATEWAY_MAX_OUTPUT_TOKENS=4096

# Prompt/completion logging stays OFF in production.
AI_GATEWAY_LOG_PROMPTS=false
AI_GATEWAY_LOG_COMPLETIONS=false
AI_GATEWAY_AUDIT_ENABLED=true

# Approved local model (OpenAI-compatible endpoint), preferred route.
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_API_KEY=

# External-provider policy. restricted = external inference blocked
# unless every gate passes: this policy=approved AND the provider in
# AI_PROVIDER_ALLOWLIST AND the app sets allowExternal=true AND the
# app's model allowlist permits the model AND classification is
# PUBLIC/INTERNAL (CONFIDENTIAL/RESTRICTED never leave the gateway).
AI_EXTERNAL_DATA_POLICY=restricted
AI_PROVIDER_ALLOWLIST=
AI_GATEWAY_EXTERNAL_FALLBACK_ENABLED=false

# Free OpenRouter models power the approved external adapter.
OPENROUTER_API_KEY=
LOCAL_MODEL_REQUEST_TIMEOUT_MS=120000
OPENROUTER_MODELS=openrouter/free

# Budget controls. Leave unset to disable; when either is set,
# providers with unknown cost are REFUSED, never guessed.
AI_MONTHLY_BUDGET_LIMIT=
AI_MAX_COST_PER_REQUEST=

# Development only. Forbidden in production; never readiness.
AI_GATEWAY_ENABLE_MOCK=false
AI_GATEWAY_MOCK_MODEL=mock-1

# AgentOS (this platform's agent engine) may call the gateway when
# both are set on the platform — opt-in; unset = direct provider.
AI_GATEWAY_BASE_URL=
AGENTOS_GATEWAY_TOKEN=
