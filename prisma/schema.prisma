  stack         String? @db.LongText
  correlationId String?
  clientId      String?
  projectId     String?
  workflow      String?
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime @default(now())

  @@index([source])
  @@index([resolved])
  @@index([createdAt])
}

model AutomationLog {
  id            String   @id @default(cuid())
  workflow      String   // LEAD_INTAKE, BUSINESS_DETECTION, ...
  trigger       String?  // WEBHOOK | FORM | API | SCHEDULER | AGENT | COMMAND
  correlationId String
