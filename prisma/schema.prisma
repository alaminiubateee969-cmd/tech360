// ---------------- AUTH / RBAC ----------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         String    @default("STAFF") // SUPER_ADMIN | ADMIN | MANAGER | STAFF
  title        String?
  passwordHash String
  isActive     Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret String?    // base32 TOTP secret (kept only while 2FA is enabled)
  twoFactorEnrolledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   Session[]
  auditLogs  AuditLog[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String? @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------- CRM CORE ----------------

model Client {
  id            String   @id @default(cuid())
  clientId      String   @unique // TECH-YYYY-NNNNNN
  name          String
  businessName  String?
  businessType  String?
  email         String?
  phone         String?
  whatsapp      String?
  country       String?
  source        String   @default("WEBSITE") // WEBSITE | WHATSAPP | EMAIL | SMS | FACEBOOK | INSTAGRAM | LINKEDIN | X | N8N
  status        String   @default("LEAD") // LEAD | CLIENT | ACTIVE | COMPLETED | CLOSED | LOST
  pipelineStage String   @default("NEW") // see lib/pipeline.ts PIPELINE_STAGES
  score         Int      @default(0)
  preferredContact String?
  notes         String? @db.Text
  mergedIntoId  String?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead            Lead?
  projects        Project[]
  communications  Communication[]
  invoices        Invoice[]
  payments        Payment[]
  receipts        PaymentReceipt[]
  refundCases     RefundCase[]
  meetings        Meeting[]
  scopes          ScopeOfWork[]
  previews        Preview[]
  formSubmissions FormSubmission[]
  memories        AiMemory[]
  approvals       ApprovalRequest[]
  scopeApprovals  ScopeApproval[]
  reviews         Review[]
  referrals       Referral[]
  referralsWon    Referral[] @relation("ReferralConverted")
  automationLogs  AutomationLog[]
  files           FileRecord[]
  deliveries      Delivery[]
  handovers       HandoverRecord[]
  contentAssets   ContentAsset[]
  agentJobs       AgentJob[]
  identities      ClientIdentity[]
  inboundEvents   InboundWebhookReceipt[]

  @@index([pipelineStage])
  @@index([status])
  @@index([email])
  @@index([whatsapp])
  @@index([mergedIntoId])
  @@index([deletedAt])
}

model Lead {
  id          String  @id @default(cuid())
  clientId    String  @unique
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requirements String? @db.Text
  budgetRange String?
  projectType String?
  interest    String?
  tracking    String? @db.Text // JSON: utm, referrer, anon id
  sourceDetails String? @db.Text
  contactedAt DateTime?
  qualifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectType])
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique // PRJ-YYYY-NNNN
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  plan        String?  // recommended plan
  status      String   @default("PLANNING") // PLANNING | ACTIVE | DEVELOPMENT | TESTING | CLIENT_REVIEW | DELIVERY | HANDOVER | COMPLETED | ON_HOLD | CANCELLED
  currency    String   @default("USD")
  totalAmount Float    @default(0)
  paidAmount  Float    @default(0)
  paymentStatus String @default("PENDING") // PENDING | PARTIAL | PAID
  timelineWeeks Int?
  startedAt   DateTime?
  deliveredAt DateTime?
  closedAt    DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       ProjectTask[]
  invoices    Invoice[]
  payments    Payment[]
  receipts    PaymentReceipt[]
  refundCases RefundCase[]
  scopes      ScopeOfWork[]
  previews    Preview[]
  meetings    Meeting[]
  deliveries  Delivery[]
  handovers   HandoverRecord[]
  reviews     Review[]
  files       FileRecord[]
  contentAssets ContentAsset[]
  agentJobs     AgentJob[]

  @@index([clientId])
  @@index([status])
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentJobId  String?  @unique
  agentJob    AgentJob? @relation(fields: [agentJobId], references: [id], onDelete: SetNull)
  title       String
  description String? @db.Text
  status      String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE | BLOCKED
  priority    String   @default("MEDIUM")
  assigneeType String  @default("AGENT") // AGENT | HUMAN
  assigneeRef String?  // agent code or user id
  order       Int      @default(0)
  dueAt       DateTime?
  completedAt DateTime?
  evidence    String? @db.Text // JSON array of file ids / notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

// ---------------- SCOPE OF WORK ----------------

model ScopeOfWork {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  version     Int      @default(1)
  status      String   @default("DRAFT") // DRAFT | AI_REVIEWED | AWAITING_ADMIN_APPROVAL | APPROVED | FINAL | SUPERSEDED
  summary     String? @db.Text
  content     String @db.LongText // JSON: items, timeline, paymentPolicy, deliverables
  aiNotes     String? @db.Text // AI review notes / recommended updates
  generatedBy String?  // agent code
  reviewedBy  String?  // admin user id
  approvedBy  String?  // admin user id
  approvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals ScopeApproval[]

  @@unique([clientId, version])
  @@index([status])
}

model ScopeApproval {
  id          String   @id @default(cuid())
  scopeId     String
  scope       ScopeOfWork @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  decision    String   // APPROVED | REVISION_REQUESTED | CLARIFICATION_REQUESTED | REJECTED
  notes       String? @db.Text
  meetingRequested Boolean @default(false)
  decidedAt   DateTime @default(now())

  @@index([clientId])
}

// ---------------- HTML PREVIEW ----------------

model Preview {
  id          String   @id @default(cuid())
  token       String   @unique
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scopeVersion Int?
  version     Int      @default(1)
  status      String   @default("GENERATED") // GENERATED | SENT | VIEWED | REVISION_REQUESTED | APPROVED | EXPIRED
  html        String @db.LongText
  viewCount   Int      @default(0)
  revisionNotes String? @db.Text
  lastIp      String?
  expiresAt   DateTime? // security: tokenized preview links expire (default 30 days)
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  viewedAt    DateTime?
  approvedAt  DateTime?

  events      PreviewEvent[]

  @@index([clientId])
  @@index([status])
}

model PreviewEvent {
  id        String   @id @default(cuid())
  previewId String
  preview   Preview  @relation(fields: [previewId], references: [id], onDelete: Cascade)
  type      String   // SENT | VIEWED | APPROVED | REVISION_REQUESTED | EXPIRED
  meta      String? @db.Text
  createdAt DateTime @default(now())

  @@index([previewId])
}

// ---------------- FINANCE ----------------

model SequenceCounter {
  id        String   @id
  prefix    String
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([prefix, year])
}

model Invoice {
  id                      String    @id @default(cuid())
  number                  String    @unique // INV-YYYY-NNNN
  clientId                String
  client                  Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId               String?
  project                 Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scopeVersion            Int?
  currency                String    @default("USD")
  amount                  Float
  subtotalMinor           Int       @default(0)
  discountMinor           Int       @default(0)
  discountReason          String? @db.Text
  taxRateBps              Int       @default(0)
  taxLabel                String?
  taxMinor                Int       @default(0)
  totalMinor              Int       @default(0)
  description             String? @db.Text
  lineItems               String? @db.LongText
  billingName             String?
  billingBusiness         String?
  billingEmail            String?
  billingAddress          String? @db.Text
  billingCountry          String?
  paymentTerms            String? @db.Text
  paymentMethodsSnapshot  String? @db.Text
  internalNotes           String? @db.Text
  customerNotes           String? @db.Text
  termsVersion            String?
  revision                Int       @default(1)
  supersedesInvoiceNumber String?
  status                  String    @default("DRAFT") // DRAFT | AWAITING_APPROVAL | APPROVED | ISSUED | SENT | VIEWED | PARTIAL | PAID | OVERDUE | VOID | CANCELLED | REFUND_PENDING | PARTIALLY_REFUNDED | REFUNDED | DISPUTED
  notes                   String? @db.Text
  approvedBy              String?
  approvedAt              DateTime?
  issuedAt                DateTime  @default(now())
  sentAt                  DateTime?
  viewedAt                DateTime?
  paidAt                  DateTime?
  voidedAt                DateTime?
  voidReason              String? @db.Text
  dueAt                   DateTime?
  updatedAt               DateTime  @default(now())

  payments    Payment[]
  receipts    PaymentReceipt[]
  refundCases RefundCase[]

  @@index([clientId])
  @@index([status])
  @@index([supersedesInvoiceNumber])
}

model Payment {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  milestone     String?  // e.g. ADVANCE | FINAL
  amount        Float
  currency      String   @default("USD")
  method        String?  // BANK_TRANSFER | BKASH | NAGAD | CARD | WISE | PAYPAL | OTHER
  transactionId String?
  status        String   @default("PENDING") // PENDING | PARTIAL | PAID | FAILED | REFUNDED | CANCELLED
  proofFileId   String?
  verifiedBy    String?  // admin user id
  verifiedAt    DateTime?
  notes         String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipt     PaymentReceipt?
  refundCases RefundCase[]

  @@unique([transactionId])
  @@index([clientId])
  @@index([status])
}

model PaymentReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amountMinor   Int
  currency      String   @default("USD")
  method        String?
  transactionId String?
  verifiedBy    String
  verifiedAt    DateTime
  issuedAt      DateTime @default(now())
  snapshot      String @db.LongText
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, issuedAt])
  @@index([invoiceId])
  @@index([projectId])
}

model RefundCase {
  id                   String    @id @default(cuid())
  caseNumber           String    @unique
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceId            String?
  invoice              Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId            String?
  payment              Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  kind                 String    @default("REFUND") // REFUND | CANCELLATION | DISPUTE
  status               String    @default("REQUESTED") // REQUESTED | UNDER_REVIEW | APPROVED | REJECTED | REFUND_PENDING | PARTIALLY_REFUNDED | REFUNDED | DISPUTE_OPEN | DISPUTE_RESOLVED | CLOSED
  requestedAmountMinor Int       @default(0)
  approvedAmountMinor  Int       @default(0)
  currency             String    @default("USD")
  reason               String @db.Text
  policyBasis          String? @db.Text
  evidenceNotes        String? @db.LongText
  resolutionNotes      String? @db.Text
  providerRefundRef    String?
  requestedBy          String
  reviewedBy           String?
  reviewedAt           DateTime?
  settledAt            DateTime?
  revokeHandover       Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([status, kind])
}

// ---------------- COMMUNICATIONS ----------------

model Communication {
  id                String   @id @default(cuid())
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  channel           String   // WHATSAPP | EMAIL | SMS | FACEBOOK | INSTAGRAM | LINKEDIN | X | WEB | PORTAL
  direction         String   // IN | OUT
  recipient         String?
  sender            String?
  subject           String? @db.Text
  body              String @db.LongText
  messageType       String   @default("TEXT") // TEXT | TEMPLATE | MEDIA | DOCUMENT | SYSTEM
  templateName      String?
  providerMessageId String?
  status            String   @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | RECEIVED | FAILED | NOT_CONFIGURED | DISABLED_BY_ADMIN | DEAD_LETTER
  error             String? @db.Text
  // Outbox retry bookkeeping — see src/lib/outbox-retry.ts.
  // attempts counts AUTOMATIC re-dispatches (the original send is 0).
  // nextRetryAt null means "eligible now"; DEAD_LETTER never retries.
  attempts          Int      @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  workflowId        String?  // automation log id / n8n workflow code
  agentCode         String?  // originating agent
  approvalId        String?  // linked approval request
  metadata          String? @db.Text // JSON

  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([clientId, channel])
  @@index([status])
  @@index([channel, direction])
  @@index([status, nextRetryAt])
}

model Meeting {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reason    String? @db.Text
  status    String   @default("REQUESTED") // REQUESTED | SCHEDULED | COMPLETED | CANCELLED | DECLINED
  channel   String   @default("GOOGLE_MEET") // GOOGLE_MEET | ZOOM | PHONE | WHATSAPP_CALL
  scheduledAt DateTime?
  bookingLink String? @db.Text
  notes     String? @db.Text
  clientResponse String? // CONFIRMED | DECLINED | RESCHEDULE_REQUESTED (set via client portal)
  clientRespondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([scheduledAt])
}

// ---------------- DELIVERY / HANDOVER ----------------

model Delivery {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String   @default("PREPARING") // PREPARING | READY | DELIVERED | CONFIRMED | PARTIAL
  checklist String @db.Text // JSON: scope, files, docs, deployment, credentials, testing
  evidence  String? @db.Text // JSON
  deliveredAt DateTime?
  clientConfirmedAt DateTime?
  confirmationAnswers String? @db.Text // JSON answers from client review
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model HandoverRecord {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String   @default("SOURCE_CODE") // SOURCE_CODE | FILES | CREDENTIALS | DOCUMENTATION
  packageToken String @unique
  status    String   @default("PENDING_APPROVAL") // PENDING_APPROVAL | PREPARED | RELEASED | DOWNLOADED | CONFIRMED | EXPIRED
  contents  String? @db.Text // JSON manifest of package
  paymentVerifiedAt DateTime?
  releasedBy String?
  releasedAt DateTime?
  downloadedAt DateTime?
  confirmedAt DateTime?
  expiryAt  DateTime?
  passwordChangeRequestedAt DateTime?
  passwordChangeConfirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Review {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rating      Int?
  content     String? @db.Text
  published   Boolean   @default(false)
  consent     Boolean   @default(false)
  status      String    @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([clientId])
  @@index([status])
}

model Referral {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String?
  contact   String?
  notes     String? @db.Text
  status    String   @default("REQUESTED") // REQUESTED | RECEIVED | CONVERTED | CLOSED
  convertedClientId String? // row id of the Client created from this referral (when CONVERTED)
  convertedClient   Client? @relation("ReferralConverted", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedAt       DateTime?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([status])
}

// ---------------- FORMS / WEBSITE ----------------

model FormSubmission {
  id           String  @id @default(cuid())
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientRequestId String? @unique(map: "FormSubmission_clientRequestId_key") @db.VarChar(64)
  requestHash  String? @db.Char(64)
  form         String  @default("CONTACT") // CONTACT | CHAT | CAREERS | NEWSLETTER
  name         String
  businessName String?
  businessType String?
  email        String?
  phone        String?
  whatsapp     String?
  country      String?
  projectType  String?
  budgetRange  String?
  details      String? @db.Text
  preferredContact String?
  tracking     String? @db.Text // JSON
  ip           String?
  contactConsentAt DateTime?
  marketingConsentAt DateTime?
  consentVersion String? @db.VarChar(64)
  status       String  @default("NEW") // NEW | PROCESSING | PROCESSED | FAILED | PENDING_REVIEW
  createdAt    DateTime @default(now())

  @@index([status])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String? @db.Text
  content     String @db.LongText
  category    String?
  tags        String? @db.Text // JSON array
  coverImage  String? @db.Text
  author      String   @default("Tech360 Team")
  status      String   @default("PUBLISHED") // DRAFT | SCHEDULED | PUBLISHED
  views       Int      @default(0)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ---------------- AI WORKFORCE ----------------

model Department {
  id          String  @id @default(cuid())
  code        String  @unique // D001...
  name        String
  category    String  // EXECUTIVE | REVENUE | DELIVERY | TECHNOLOGY | CONTENT | OPERATIONS | GOVERNANCE | SUPPORT
  description String? @db.Text
  createdAt   DateTime @default(now())

  agents        AiAgent[]
  dccAssessments DepartmentCapabilityAssessment[]
}

model DepartmentCapabilityAssessment {
  id                  String   @id @default(cuid())
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  thresholdVersion   String   @db.VarChar(32)
  status              String   @default("UNDER_REVIEW") // CERTIFIED | BLOCKED | UNDER_REVIEW
  sopCoverage         Float?
  knowledgeCoverage  Float?
  skillCoverage       Float?
  testPassRate        Float?
  kpiAchievement      Float?
  securityCompliance Float?
  auditCompliance     Float?
  selfRecoveryRate    Float?
  humanEscalationRate Float?
  evidence            String @db.LongText // JSON: per-metric source, method, samples and limitations
  measurementStart    DateTime?
  measurementEnd      DateTime?
  assessedBy          String
  assessedAt          DateTime @default(now())
  expiresAt           DateTime?

  @@index([departmentId, assessedAt])
  @@index([status, expiresAt])
}

model AiAgent {
  id           String   @id @default(cuid())
  code         String   @unique // CEO-001, CRM-014 ...
  name         String
  title        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  purpose      String @db.Text
  systemPrompt String @db.LongText
  tools        String @db.Text // JSON array of tool names
  permissions  String @db.Text // JSON
  requiresApproval Boolean @default(false)
  status       String   @default("ACTIVE") // ACTIVE | PAUSED | RETIRED
  model        String   @default("default")
  dailyQuota   Int      @default(200)
  tokensToday  Int      @default(0)
  executionCount Int    @default(0)
  successCount Int      @default(0)
  failureCount Int      @default(0)
  parentCode   String?  // hierarchy
  level        Int      @default(3) // 1 CEO ... 5 specialist
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executions AiAgentExecution[]
  jobs       AgentJob[]

  @@index([departmentId])
  @@index([status])
  @@index([parentCode])
}

model AiAgentExecution {
  id            String   @id @default(cuid())
  agentCode     String
  agent         AiAgent  @relation(fields: [agentCode], references: [code], onDelete: Cascade)
  correlationId String
  clientId      String?
  projectId     String?
  workflow      String?
  input         String @db.LongText
  output        String? @db.LongText
  status        String   @default("RUNNING") // RUNNING | SUCCESS | FAILED | TIMEOUT | AWAITING_APPROVAL
  tokensUsed    Int      @default(0)
  durationMs    Int?
  error         String? @db.Text
  metadata      String? @db.Text // provider and safe execution metadata; never credentials
  createdAt     DateTime @default(now())
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([agentCode])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
  @@index([startedAt])
}

// Durable inference and explicitly allowlisted internal tool queue. A completed
// inference or task-creation tool is not proof of QA, external delivery, or acceptance.
model AgentJob {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  payloadHash    String   @db.Char(64)
  taskType       String   @default("INFERENCE") // INFERENCE | TOOL_CALL | SKILL | WORKFLOW | DOCUMENT; only the explicit executor allowlist can run a tool
  toolName       String?  @db.VarChar(80)
  toolArgs       String? @db.LongText // JSON arguments for an allowlisted internal tool; never provider credentials
  // Nullable so the SAME durable queue can carry skill and workflow tasks
  // that are not owned by an LLM agent (migration 8_private_ai_platform).
  // INFERENCE and TOOL_CALL jobs always set it; the worker refuses to run a
  // job whose task type needs an agent but has none.
  agentCode      String?
  agent          AiAgent? @relation(fields: [agentCode], references: [code], onDelete: Restrict)
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  correlationId  String   @unique
  workflow       String?
  input          String @db.LongText
  contextNote    String? @db.LongText
  expectJson     Boolean  @default(false)
  status         String   @default("QUEUED") // QUEUED | RUNNING | RETRYING | AWAITING_APPROVAL | COMPLETED | FAILED | TIMED_OUT | CANCELLED
  approvalState  String   @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | APPROVED | REJECTED
  requestedBy    String?
  approvedBy     String?
  approvedAt     DateTime?
  approvalNote   String? @db.Text
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  checkpoint     String? @db.LongText // JSON: phase, executionId, safe worker metadata
  output         String? @db.LongText
  lastError      String? @db.Text
  availableAt    DateTime @default(now())
  claimedBy      String?
  leaseUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  createdTask    ProjectTask?

  @@index([status, availableAt, createdAt])
  @@index([status, leaseUntil])
  @@index([clientId, createdAt])
  @@index([agentCode, createdAt])
  @@index([projectId, createdAt])
}

// PII-safe client identity index. Only verified identifiers are persisted; the
// normalized value itself is never stored, only a keyed HMAC-SHA-256 digest.
model ClientIdentity {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  identityType      String   @db.VarChar(16) // EMAIL | PHONE
  normalizedHash    String   @db.Char(64)
  verificationSource String  @db.VarChar(40)
  verifiedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([identityType, normalizedHash], map: "ClientIdentity_identityType_normalizedHash_key")
  @@index([clientId])
  @@map("client_identities")
}

// Provider webhook replay receipt with a bounded lease and token-based claim.
model InboundWebhookReceipt {
  id              String   @id @default(cuid())
  provider        String   @db.VarChar(16)
  eventIdHash     String   @db.Char(64)
  eventType       String   @default("MESSAGE") @db.VarChar(32)
  status          String   @default("PROCESSING") @db.VarChar(16) // PROCESSING | PROCESSED | FAILED
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  attempts        Int      @default(1)
  claimToken      String?  @db.VarChar(36)
  leaseExpiresAt  DateTime?
  lastError       String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  processedAt     DateTime?

  @@unique([provider, eventIdHash], map: "InboundWebhookReceipt_provider_eventIdHash_key")
  @@index([status, leaseExpiresAt])
  @@index([clientId, createdAt])
  @@map("inbound_webhook_receipts")
}

model AiOpsLock {
  id         String   @id
  owner      String?
  lockedUntil DateTime
  updatedAt  DateTime @updatedAt

  @@index([lockedUntil])
}

model AiMemory {
  id        String   @id @default(cuid())
  scope     String   // COMPANY | BRAND | SERVICES | PRICING | POLICIES | CLIENT | PROJECT | COMMUNICATION | WORKFLOW | KNOWLEDGE | AGENT | TASK | LESSON
  key       String
  content   String @db.LongText
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  agentCode String?
  importance Int     @default(5)
  hits      Int      @default(0)
  /// The memory TYPE: WORKING | EPISODIC | SEMANTIC | PROCEDURAL.
  memoryType String  @default("SEMANTIC")
  /// The access level that governs who may read this memory.
  accessLevel String  @default("INTERNAL")
  /// The enterprise scope that owns this memory.
  departmentCode String?
  /// The number of times this memory has been revised.
  version   Int      @default(1)
  /// True when the memory has been reviewed and confirmed.
  validated Boolean  @default(false)
  /// Where the memory came from: PLATFORM | AGENT | HUMAN | LEARNING_ENGINE.
  source    String   @default("PLATFORM")
  /// When the memory stops being valid.
  expiresAt DateTime?
  /// The run that produced it.
  correlationId String?
  /// The tags that make it retrievable.
  tags      String? @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope])
  @@index([clientId])
  @@index([key])
  @@index([scope, memoryType])
  @@index([accessLevel])
  @@index([departmentCode])
}

model KnowledgeDocument {
  id             String   @id @default(cuid())
  title          String
  filename       String
  mimeType       String
  size           Int
  classification String   @default("PRIVATE") // PUBLIC | PRIVATE | CONFIDENTIAL | HIGHLY_SENSITIVE
  status         String   @default("UPLOADED") // UPLOADED | SCANNED | QUARANTINED | INDEXED | APPROVED | ARCHIVED
  extractedText  String? @db.LongText
  scanResult     String? @db.Text // JSON
  sha256         String?
  uploadedBy     String?
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([classification])
}

model PromptTemplate {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  category   String
  agentCode  String?
  template   String @db.LongText
  variables  String @db.Text // JSON
  // Retrieval metadata — the prompt library is 50,000+ slots, so the
  // runtime MUST retrieve rather than load. These are the dimensions
  // the retriever scores on.
  stage      String   @default("TASK_EXECUTION") // INITIALIZATION | TASK_INTAKE | TASK_EXECUTION | DECISION_SUPPORT | RESEARCH | TOOL_USAGE | QUALITY_REVIEW | ESCALATION | REPORTING | COLLABORATION | KNOWLEDGE_SHARING | ERROR_RECOVERY | REFLECTION | LEARNING | PERFORMANCE_REVIEW | EMERGENCY_RESPONSE
  priority   Int      @default(5)
  quality    Float    @default(0.5)
  language   String   @default("en")
  version    String   @default("1.0.0")
  role       String?
  departmentCode String?
  skillCode  String?
  sopKey     String?
  tags       String? @db.Text // JSON array
  status     String   @default("ACTIVE") // DRAFT | ACTIVE | RETIRED
  usageCount Int      @default(0)
  successCount Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, status])
  @@index([agentCode, stage])
  @@index([departmentCode, stage])
  @@index([skillCode])
  @@index([sopKey])
}

