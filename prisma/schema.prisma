// ---------------- MODELS ----------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(STAFF)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff      Staff?
  auditLogs  AuditLog[]
  agentRuns  AgentRun[]
  approvals  Approval[]      @relation("ApprovalDecider")
  approvalsR Approval[]      @relation("ApprovalRequester")
  paymentsV  Payment[]       @relation("PaymentVerifier")
  scopesA    Scope[]         @relation("ScopeApprover")
  filesU     FileItem[]      @relation("FileUploader")
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  company    String?
  source     LeadSource @default(WEBSITE)
  status     LeadStatus @default(NEW)
  score      Int        @default(50)
  message    String?
  projectId  String?
  assignedTo String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project        Project?       @relation(fields: [projectId], references: [id])
  communications Communication[]
  client         Client?

  
  @@index([source])
}

model Project {
  id        String        @id @default(cuid())
  name      String
  clientId  String?
  scope     String?
  status    ProjectStatus @default(PLANNING)
  budget    Float         @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  leads          Lead[]
  communications Communication[]
  scopes         Scope[]
  payments       Payment[]
  files          FileItem[]
  client    Client?  @relation(fields: [clientId], references: [id])
  tasks          Task[]
  invoices       Invoice[]
  meetings       Meeting[]
  evidence       Evidence[]
  reviews        Review[]
  milestones     ProjectMilestone[]
}

model Communication {
  id        String    @id @default(cuid())
  leadId    String?
  projectId String?
  channel   Channel
  direction Direction @default(INBOUND)
  subject   String
  body      String
  createdAt DateTime  @default(now())

  lead    Lead?    @relation(fields: [leadId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])
  clientId String?

  @@index([channel])
}

model Scope {
  id           String      @id @default(cuid())
  projectId    String
  title        String
  deliverables String // JSON-encoded list
  timeline     String
  budget       Float       @default(0)
  status       ScopeStatus @default(DRAFT)
  scopeVersion      String   @default("SOW-v1.0")
  termsAccepted     Boolean  @default(false)
  refundPolicyAccepted Boolean @default(false)
  previewAcknowledged Boolean @default(false)
  immutableSnapshot  String?  // JSON snapshot at approval time
  approvedByClient  String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project   Project @relation(fields: [projectId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])
  versions ScopeVersion[]
  clientId String?
  approver  User?   @relation("ScopeApprover", fields: [approvedBy], references: [id])
}

model Payment {
  id            String        @id @default(cuid())
  projectId     String
  amount        Float
  currency      String        @default("USD")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod @default(CARD)
  transactionId String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project  Project @relation(fields: [projectId], references: [id])
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?
  verifier User?   @relation("PaymentVerifier", fields: [verifiedBy], references: [id])
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  entityId    String
  requestedBy String
  status      ApprovalStatus @default(PENDING)
  decisionBy  String?
  decisionAt  DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  decider   User? @relation("ApprovalDecider", fields: [decisionBy], references: [id])
  requester User  @relation("ApprovalRequester", fields: [requestedBy], references: [id])
}

model FileItem {
  id         String       @id @default(cuid())
  name       String
  category   FileCategory @default(OTHER)
  projectId  String?
  sizeKb     Int          @default(0)
  storagePath String
  mimeType    String       @default("application/octet-stream")
  uploadedBy String?
  createdAt  DateTime     @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  client  Client? @relation(fields: [clientId], references: [id])
  clientId String?
  uploader User?   @relation("FileUploader", fields: [uploadedBy], references: [id])
}

model Staff {
  id          String   @id @default(cuid())
  userId      String   @unique
  role        UserRole @default(STAFF)
  permissions String   // pipe-separated
  department  String
  hourlyRate  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  content   String
  tags      String   // pipe-separated
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entityType String
  entityId  String
  metadata  String   // JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType])
}

model Agent {
  id          String      @id @default(cuid())
  name        String
  role        String
  description String
  status      AgentStatus @default(ONLINE)
  skillPath   String      // AgentOS SKILL.md path
  lastAction  String?
  config      String      // JSON
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  runs AgentRun[]

  
}

model AgentRun {
  id         String         @id @default(cuid())
  agentId    String
  userId     String?
  input      String
  output     String?
  status     AgentRunStatus @default(RUNNING)
  durationMs Int            @default(0)
  createdAt  DateTime       @default(now())

  agent Agent @relation(fields: [agentId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([agentId])
}

model Conversation {
  id            String        @id @default(cuid())
  channel       SocialChannel
  contactName   String
  contactHandle String
  lastMessageAt DateTime      @default(now())
  unreadCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages Message[]

  @@index([channel])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  channel        SocialChannel
  direction      Direction     @default(INBOUND)
  from           String
  to             String
  body           String
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

