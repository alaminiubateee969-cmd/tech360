  WHATSAPP
  SOCIAL
  REFERRAL
  DIRECT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  DELIVERED
}

enum Channel {
  EMAIL
  WHATSAPP
  CALL
  MEETING
  SOCIAL
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum ScopeStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentStatus {
