  definition  String @db.LongText // importable n8n JSON (no secrets)
  status      String   @default("AVAILABLE") // AVAILABLE | IMPORTED | RUNNING | ERROR
  lastRunAt   DateTime?
  lastRunStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
