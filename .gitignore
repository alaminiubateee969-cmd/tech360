# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# allow the safe template through (placeholders only)
!.env.example

# QA tooling artifacts
tool-results/

# NOTE: package-lock.json IS committed. The application and top-level CI use npm
# for reproducible installs. bun.lock is retained for existing Bun-only tools.

# --- Secrets / private data (never commit or serve) ---
# Local/legacy SQLite artifacts may contain sensitive test data; never use them
# as production storage (production Prisma provider is MySQL).
/db/*.db
/db/*.db-journal
/db/*.sqlite*
# Raw owner uploads (screenshots, pasted briefs, zips)
/upload/
# Source archives must never live under public/
/archives/
/public/downloads/
*.pem
*.key
